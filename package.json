{
  "name": "web-components",
  "version": "4.0.0",
  "private": false,
  "sideEffects": [
    "*.vue",
    "*.css"
  ],
  "type": "module",
  "files": [
    "dist",
    "dist/src",
    "src/assets/styles/theme.css"
  ],
  "main": "./dist/main.js",
  "types": "./dist/lib/main.d.ts",
  "exports": {
    ".": {
      "import": "./dist/main.js",
      "types": "./dist/lib/main.d.ts"
    },
    "./theme.css": "./src/assets/styles/theme.css",
    "./dist/*": "./dist/*"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run generate-icon-types",
    "build": "run-p \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.stories.json && vue-tsc --noEmit -p tsconfig.node.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run && npm run test:scripts",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "storybook": "storybook dev -p 6006",
    "storybook-docs": "storybook --docs --no-manager-cache",
    "build-storybook": "storybook build -o ./storybook-static",
    "build-storybook-docs": "storybook build --docs",
    "prepare": "husky && npm run build",
    "generate-icon-types": "npx tsx src/shared/generate-icon-types.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.2.8",
    "@storybook/addon-links": "^10.0.2",
    "@storybook/addon-themes": "^10.0.2",
    "@storybook/vue3": "^10.0.2",
    "@storybook/vue3-vite": "^10.0.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.13.14",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.6",
    "jsdom": "^30.1.0",
    "npm-run-all2": "^6.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.3.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass": "^1.82.0",
    "storybook": "^10.0.2",
    "tailwindcss": "^4.2.1",
    "terser": "^5.44.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.12",
    "vite-plugin-dts": "4.3.0",
    "vite-svg-loader": "^5.1.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^2.2.0"
  }
}
